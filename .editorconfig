# Editor settings for this repository; checked in CI by .github/workflows/lint.yml.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell: UTF-8 with BOM and CRLF. Windows PowerShell 5.1 (used by Chocolatey) misreads
# UTF-8 files without a BOM as soon as they contain a non-ASCII character. This is also the
# format AU writes when it updates tools\chocolateyInstall.ps1.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# Windows-only files
[*.{cmd,bat}]
end_of_line = crlf

# Legal files shipped inside packages are copies of upstream texts: keep them as they are.
[automatic/**/tools/*.txt]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Markdown uses two trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
